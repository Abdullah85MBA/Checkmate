	"simulations": {
		"Uptime and Service Monitoring": {
			"name": "Uptime and Service Monitoring",
			"simSteps": [
				{
					"simStepId": "4b027a51-173b-4538-a9c0-632891559679",
					"diagramNodeId": "7576b5e3-fc0a-4771-82ce-bbf4905f6dee",
					"simStepLabel": "User Initiates Monitor Creation",
					"simStepDescription": "On the 'Create Uptime Monitor' page, the user selects the monitor type (e.g., HTTP), fills in the URL, display name, and check frequency, then clicks the 'Create monitor' button. This triggers the `onSubmit` event handler.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "client/src/Pages/Uptime/Create/index.jsx",
						"startLine": "99",
						"endLine": "150",
						"relevantVariables": [
							"onSubmit",
							"createMonitor",
							"monitorValidation",
							"setErrors"
						]
					},
					"inputDataExample": "{\"event\": {\"type\": \"click\"}}",
					"outputDataExample": "{\"monitor\": {\"url\": \"google.com\", \"name\": \"Google\", \"type\": \"http\", \"interval\": 60000, \"notifications\": [], \"ignoreTlsErrors\": false, \"matchMethod\": \"equal\", \"expectedValue\": \"\", \"jsonPath\": \"\"}, \"redirect\": \"/uptime\"}"
				},
				{
					"simStepId": "9630ce33-6e7f-4366-9920-292c796236ac",
					"diagramNodeId": "2d3f34ef-4142-4996-ac1a-1310007de314",
					"simStepLabel": "Send Create Monitor Request",
					"simStepDescription": "The `useCreateMonitor` hook is called, which then uses the `networkService` to send a POST request to the `/api/v1/monitors` endpoint with the new monitor's configuration in the request body.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "client/src/Hooks/monitorHooks.js",
						"startLine": "285",
						"endLine": "285",
						"relevantVariables": [
							"networkService.createMonitor"
						]
					},
					"inputDataExample": "{\"monitor\": {\"url\": \"https://google.com\", \"name\": \"Google\", \"type\": \"http\", \"interval\": 60000, \"description\": \"Google\", \"notifications\": []}}",
					"outputDataExample": "{\"monitor\": {\"url\": \"https://google.com\", \"name\": \"Google\", \"type\": \"http\", \"interval\": 60000, \"description\": \"Google\", \"notifications\": []}}"
				},
				{
					"simStepId": "fe7ed684-683b-4379-83d0-88d83287a6c4",
					"diagramNodeId": "26f60271-d3c6-47f4-b86e-4c7b973b4b62",
					"simStepLabel": "Server Handles Monitor Creation",
					"simStepDescription": "The backend receives the API request at the `/monitors` route. The `monitorController.createMonitor` method handles the request. It retrieves the user's ID and team ID from the request object and calls the database module to persist the new monitor.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "server/controllers/monitorController.js",
						"startLine": "230",
						"endLine": "252",
						"relevantVariables": [
							"createMonitor",
							"this.db.createMonitor",
							"this.jobQueue.addJob"
						]
					},
					"inputDataExample": "{\"body\": {\"url\": \"https://google.com\", \"name\": \"Google\", \"type\": \"http\", \"interval\": 60000, \"description\": \"Google\", \"notifications\": []}, \"user\": {\"_id\": \"user_456\", \"teamId\": \"team_789\"}}",
					"outputDataExample": "{\"body\": {\"url\": \"https://google.com\", \"name\": \"Google\", \"type\": \"http\", \"interval\": 60000, \"description\": \"Google\", \"notifications\": []}, \"teamId\": \"team_789\", \"userId\": \"user_456\"}"
				},
				{
					"simStepId": "ff69cbda-5b1c-4c3f-819d-b9af5b68dea2",
					"diagramNodeId": "ebad0b72-35d1-493f-aa9a-5055030cb996",
					"simStepLabel": "Save Monitor to Database",
					"simStepDescription": "The controller invokes the database module, passing the monitor data along with user and team IDs to be saved.",
