					"diagramNodeId": "dc80b0ed-b3ae-4ea3-8d8b-5ede9fd95b79",
					"simStepLabel": "Authorization Check Fails",
					"simStepDescription": "The function compares the team ID from the user's token (`team_abc123`) with the team ID from the monitor document (`team_def456`). Since they do not match, an authorization error is thrown.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "server/src/service/v1/business/monitorService.js",
