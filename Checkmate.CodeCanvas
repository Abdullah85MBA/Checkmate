		},
		"0495b2d9-0432-4dc2-9032-eb1073fb5e84": {
			"path": "0495b2d9-0432-4dc2-9032-eb1073fb5e84",
			"cellName": "Backend Processes Lighthouse Data - CheckService.ts:L82-102",
			"cellId": "0495b2d9-0432-4dc2-9032-eb1073fb5e84",
			"visible": true,
			"parentCellId": "25c2c437-3c1b-45e2-b0e8-21dfa9290d9e"
		},
		"server/src/service/v2/business/CheckService.ts-simstep-bb9377e8-faeb-43fd-8f60-dfec8c99f165": {
			"path": "server/src/service/v2/business/CheckService.ts-simstep-bb9377e8-faeb-43fd-8f60-dfec8c99f165",
			"fileName": "CheckService.ts",
			"wiki": "The CheckService receives the raw Lighthouse JSON report. It extracts key metrics like Performance, Accessibility, SEO, Best Practices, and individual audit scores (e.g., FCP, LCP, CLS), and structures them into a standardized 'Check' object.",
			"cellName": "Backend Processes Lighthouse Data - CheckService.ts:L82-102",
			"cellId": "0495b2d9-0432-4dc2-9032-eb1073fb5e84",
			"visible": true,
			"startLine": 82,
			"endLine": 102,
			"parentCellId": "25c2c437-3c1b-45e2-b0e8-21dfa9290d9e",
			"parentPath": "server/src/service/v2/business/CheckService.ts",
			"simSteps": [
				{
					"simulationKey": "Page Speed and Web Performance Monitoring",
					"simStepId": "bb9377e8-faeb-43fd-8f60-dfec8c99f165"
				}
			]
		},
		"9f05eb9c-c2e0-49c4-b6f0-943f9653f723": {
			"path": "9f05eb9c-c2e0-49c4-b6f0-943f9653f723",
			"cellName": "User Views Monitor Details Page - index.jsx:L27-31",
			"cellId": "9f05eb9c-c2e0-49c4-b6f0-943f9653f723",
