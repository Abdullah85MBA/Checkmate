		"server/src/service/v1/business/monitorService.js-simstep-cb8a972d-acec-43e2-93ae-04ad5cec8744": {
			"path": "server/src/service/v1/business/monitorService.js-simstep-cb8a972d-acec-43e2-93ae-04ad5cec8744",
			"fileName": "monitorService.js",
			"wiki": "The `monitorService` first verifies that the user's team has access to the requested monitor. Then, it calls the `monitorModule` to fetch the statistical data from the database.",
			"cellName": "Backend: Service Layer Logic - monitorService.js:L46-56",
