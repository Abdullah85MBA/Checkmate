					"outputDataExample": "{\"body\": {\"url\": \"https://google.com\", \"name\": \"Google\", \"type\": \"http\", \"interval\": 60000, \"description\": \"Google\", \"notifications\": []}, \"teamId\": \"team_789\", \"userId\": \"user_456\"}"
