		"server/src/service/v1/business/monitorService.js-simstep-b6146fe6-723b-4c5b-85cf-95e45e4affd6": {
			"path": "server/src/service/v1/business/monitorService.js-simstep-b6146fe6-723b-4c5b-85cf-95e45e4affd6",
			"fileName": "monitorService.js",
			"wiki": "The `MonitorService` uses `papaparse` to parse the CSV string into a JSON object. It then enriches this data with team and user IDs, validates it, and calls the database module to create the monitors.",
			"cellName": "Flow 1: Service Parses CSV and Creates Monitors - monitorService.js:L84-126",
			"cellId": "fd86118c-7b5a-4479-bc66-7271d10cf886",
