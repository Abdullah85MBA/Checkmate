		"server/src/service/v2/business/MonitorService.ts-simstep-ecfbd286-ae62-4691-800a-6379ffba97d6": {
			"path": "server/src/service/v2/business/MonitorService.ts-simstep-ecfbd286-ae62-4691-800a-6379ffba97d6",
			"fileName": "MonitorService.ts",
			"wiki": "The backend's MonitorService receives the request. It uses a MongoDB aggregation pipeline to query the 'checks' collection, grouping the Lighthouse scores by a specific time interval (e.g., hourly or daily) to prepare the data for charting.",
			"cellName": "Backend Aggregates Performance Data - MonitorService.ts:L343-353",
			"cellId": "e42e85f2-beb8-4adf-bbd0-e039c46f6ea7",
			"visible": true,
			"startLine": 343,
			"endLine": 353,
			"parentCellId": "42a55243-041e-4cf7-ad7a-742d03dbaf60",
