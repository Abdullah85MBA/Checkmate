					"diagramNodeId": "",
					"simStepLabel": "API Responds with 403 Forbidden Error",
					"simStepDescription": "The thrown error is caught by the global error handler, which terminates the request and sends a 403 Forbidden status code back to the client, preventing unauthorized data access.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "server/src/service/v1/business/monitorService.js",
