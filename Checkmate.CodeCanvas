			"fileName": "index.jsx",
			"wiki": "A user navigates to the details page for their PageSpeed monitor. The `PageSpeedDetails` React component is mounted, which then triggers a data fetch for the monitor's historical performance.",
			"cellName": "User Views Monitor Details Page - index.jsx:L27-31",
			"cellId": "9f05eb9c-c2e0-49c4-b6f0-943f9653f723",
