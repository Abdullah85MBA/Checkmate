		"server/src/db/v1/modules/monitorModule.js-simstep-971e3785-83c6-4875-8758-14045eca530d": {
			"path": "server/src/db/v1/modules/monitorModule.js-simstep-971e3785-83c6-4875-8758-14045eca530d",
			"fileName": "monitorModule.js",
			"wiki": "The `monitorModule` constructs and executes a query against the `Check` collection in MongoDB. It fetches all checks for the given `monitorId` within the specified `dateRange`, and then processes them (e.g., grouping, averaging) to generate the required statistics for the chart.",
			"cellName": "Backend: Database Query Execution - monitorModule.js:L259-296",
			"cellId": "eadd450d-c210-46ec-85da-22c18dadfa07",
