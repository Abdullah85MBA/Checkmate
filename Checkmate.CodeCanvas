				}
			]
		},
		"e42e85f2-beb8-4adf-bbd0-e039c46f6ea7": {
			"path": "e42e85f2-beb8-4adf-bbd0-e039c46f6ea7",
			"cellName": "Backend Aggregates Performance Data - MonitorService.ts:L343-353",
			"cellId": "e42e85f2-beb8-4adf-bbd0-e039c46f6ea7",
			"visible": true,
			"parentCellId": "42a55243-041e-4cf7-ad7a-742d03dbaf60"
