		"Notifications and Alerting": {
			"name": "Notifications and Alerting",
			"simSteps": [],
			"description": "<ul><li>Users can configure various notification channels to receive real-time alerts when incidents occur</li><li>The system supports multiple channels including Email, Slack, Discord, Telegram, PagerDuty, and generic Webhooks</li><li>Notifications are sent when a monitor's status changes (e</li><li>g</li><li>, goes down or comes back up)</li><li>Alerts can also be triggered for hardware monitors when predefined thresholds are breached</li></ul>",
			"simulationNodesAndEdges": {},
			"isAIGenerated": true,
			"keywords": "notificationService, Notification, handleNotifications"
		},
		"Incident Management and Historical Data Visualization": {
			"name": "Incident Management and Historical Data Visualization",
			"simSteps": [],
			"description": "<ul><li>The application provides detailed views of a monitor's history, including uptime percentages, response time charts, and a log of past incidents</li><li>Users can access historical performance data over various time frames (e</li><li>g</li><li>, 24 hours, 7 days, 30 days)</li><li>This data is visualized using interactive charts and graphs to analyze trends and diagnose recurring problems</li></ul>",
			"simulationNodesAndEdges": {},
			"isAIGenerated": true,
			"keywords": "MonitorStats, AreaChart, getMonitorStatsById"
		},
		"Public Status Pages": {
			"name": "Public Status Pages",
			"simSteps": [],
			"description": "<ul><li>Users can create public-facing status pages that display the current status of selected monitors</li><li>These pages can be customized with a logo, company name, color scheme, and a unique URL</li><li>Options are available to show or hide uptime percentages and performance charts for public viewers</li><li>This feature is crucial for businesses needing to communicate service availability to their customers</li></ul>",
			"simulationNodesAndEdges": {},
			"isAIGenerated": true,
			"keywords": "StatusPage, getStatusPageByUrl, isPublished"
		},
		"Infrastructure Monitoring": {
			"name": "Infrastructure Monitoring",
			"simSteps": [],
			"description": "<ul><li>Users can monitor the hardware health of their servers, which requires a companion 'Capture' agent</li><li>The system tracks key metrics such as CPU usage, memory consumption, disk space, and system temperature</li><li>Users can set custom alert thresholds for each hardware metric to be proactively notified of potential issues</li><li>Detailed historical data for these metrics is available through charts and gauges</li></ul>",
			"simulationNodesAndEdges": {},
			"isAIGenerated": true,
			"keywords": "HardwareCheck, infrastructure, thresholds"
		},
		"Page Speed and Web Performance Monitoring": {
			"name": "Page Speed and Web Performance Monitoring",
			"simSteps": [],
			"description": "<ul><li>Users can monitor the performance of their webpages, analyzing metrics beyond simple uptime</li><li>The system runs scheduled performance audits on webpages, likely leveraging Google's Lighthouse</li><li>It tracks key metrics like First Contentful Paint (FCP), Largest Contentful Paint (LCP), and Speed Index</li><li>This helps in optimizing user experience and identifying frontend performance bottlenecks</li></ul>",
			"simulationNodesAndEdges": {},
			"isAIGenerated": true,
			"keywords": "PageSpeed, PageSpeedCheck, lighthouseResult"
		},
		"Scheduled Maintenance Windows": {
			"name": "Scheduled Maintenance Windows",
			"simSteps": [],
			"description": "<ul><li>Users can define scheduled maintenance windows for specific monitors to avoid false alarms during planned service interruptions</li><li>During a maintenance window, monitoring checks and alerting are temporarily suppressed for the selected services</li><li>This feature ensures uptime statistics remain accurate and prevents alert fatigue for operations teams</li><li>Maintenance can be set as one-time or recurring events</li></ul>",
			"simulationNodesAndEdges": {},
			"isAIGenerated": true,
			"keywords": "MaintenanceWindow, createMaintenanceWindows, isInMaintenanceWindow"
		},
		"User and Team Management": {
			"name": "User and Team Management",
			"simSteps": [],
			"description": "<ul><li>The application supports a multi-user environment where users are organized into teams</li><li>Administrators can invite new users to a team via email</li><li>Monitors, status pages, and other resources are scoped to a specific team, providing data segregation and collaborative access for organizations</li><li>Role-based access control (admin, superadmin) is used to manage permissions</li></ul>",
			"simulationNodesAndEdges": {},
			"isAIGenerated": true,
			"keywords": "Team, inviteController, verifyTeamAccess"
		},
		"Bulk Monitor Management via CSV": {
			"name": "Bulk Monitor Management via CSV",
			"simSteps": [],
			"description": "<ul><li>For users with many services, the application allows for efficient management through CSV files</li><li>Users can import a list of monitors by uploading a CSV, enabling quick setup of numerous monitoring jobs</li><li>A sample CSV template is provided to ensure correct formatting</li><li>Additionally, existing monitor configurations can be exported to a CSV file for backup or migration</li></ul>",
			"simulationNodesAndEdges": {},
			"isAIGenerated": true,
			"keywords": "createBulkMonitors, exportMonitorsToCSV, papaparse"
		},
