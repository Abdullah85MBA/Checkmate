		"client/src/Pages/v1/PageSpeed/Create/index.jsx-simstep-0894c9a0-1ffa-4269-9596-eb3d4e749314": {
			"path": "client/src/Pages/v1/PageSpeed/Create/index.jsx-simstep-0894c9a0-1ffa-4269-9596-eb3d4e749314",
			"fileName": "index.jsx",
			"wiki": "The user navigates to the 'Create PageSpeed Monitor' page. They input the URL of the website they want to monitor, give it a display name, and select a checking interval. The monitor type is set to 'pagespeed'.",
			"cellName": "User Configures PageSpeed Monitor - index.jsx:L51-59",
			"cellId": "98eaa7f6-9ce5-4574-824f-4b6064a2d3fa",
			"visible": true,
			"startLine": 51,
			"endLine": 59,
			"parentCellId": "ed0dcd77-6735-472c-8c27-bd86026ec694",
			"parentPath": "client/src/Pages/v1/PageSpeed/Create/index.jsx",
			"simSteps": [
				{
					"simulationKey": "Page Speed and Web Performance Monitoring",
					"simStepId": "0894c9a0-1ffa-4269-9596-eb3d4e749314"
				}
			]
		},
		"b16579ba-45c3-4cd1-b296-bc677479f37c": {
			"path": "b16579ba-45c3-4cd1-b296-bc677479f37c",
			"cellName": "Backend: Create Monitor and Schedule Job - MonitorService.ts:L30-39",
			"cellId": "b16579ba-45c3-4cd1-b296-bc677479f37c",
			"visible": true,
			"parentCellId": "42a55243-041e-4cf7-ad7a-742d03dbaf60"
		},
		"server/src/service/v2/business/MonitorService.ts-simstep-643bb1bf-d4bf-42c1-aa99-a3674aaddf73": {
			"path": "server/src/service/v2/business/MonitorService.ts-simstep-643bb1bf-d4bf-42c1-aa99-a3674aaddf73",
			"fileName": "MonitorService.ts",
			"wiki": "The backend server receives the request. The MonitorService validates the data, creates a new 'Monitor' document with 'type: pagespeed', saves it to the database, and adds a recurring job to a queue to perform the PageSpeed check at the specified interval.",
			"cellName": "Backend: Create Monitor and Schedule Job - MonitorService.ts:L30-39",
			"cellId": "b16579ba-45c3-4cd1-b296-bc677479f37c",
			"visible": true,
			"startLine": 30,
			"endLine": 39,
			"parentCellId": "42a55243-041e-4cf7-ad7a-742d03dbaf60",
			"parentPath": "server/src/service/v2/business/MonitorService.ts",
			"simSteps": [
				{
					"simulationKey": "Page Speed and Web Performance Monitoring",
					"simStepId": "643bb1bf-d4bf-42c1-aa99-a3674aaddf73"
				}
			]
		},
		"8034699e-b317-49f4-b527-6bb76fb144f6": {
			"path": "8034699e-b317-49f4-b527-6bb76fb144f6",
			"cellName": "Backend Requests Data from Google PageSpeed API - NetworkService.ts:L129-152",
			"cellId": "8034699e-b317-49f4-b527-6bb76fb144f6",
			"visible": true,
			"parentCellId": "f0083a6a-ee0f-4d80-8355-8c2df40e8f84"
		},
		"server/src/service/v2/infrastructure/NetworkService.ts-simstep-665fe06f-5ffc-4746-bfb4-553ad084b9f1": {
			"path": "server/src/service/v2/infrastructure/NetworkService.ts-simstep-665fe06f-5ffc-4746-bfb4-553ad084b9f1",
			"fileName": "NetworkService.ts",
			"wiki": "The NetworkService constructs the API request URL for Google's PageSpeed Insights service, including the target website URL and the globally configured PAGESPEED_API_KEY. It then makes an external HTTP GET request.",
			"cellName": "Backend Requests Data from Google PageSpeed API - NetworkService.ts:L129-152",
			"cellId": "8034699e-b317-49f4-b527-6bb76fb144f6",
			"visible": true,
			"startLine": 129,
			"endLine": 152,
			"parentCellId": "f0083a6a-ee0f-4d80-8355-8c2df40e8f84",
