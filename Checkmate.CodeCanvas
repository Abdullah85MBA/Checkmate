					"simulationKey": "Team and User Management with Role-Based Access",
					"simStepId": "a2f4428e-733a-4424-88db-fc6fdfc63566"
				}
			]
		},
		"07ae6cee-680e-4129-bab7-15deb3b3e886": {
			"path": "07ae6cee-680e-4129-bab7-15deb3b3e886",
