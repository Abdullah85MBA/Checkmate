			"fileName": "controllers.js",
			"wiki": "The `authController` on the backend handles the registration request. It validates the invite token, hashes the user's password, and invokes the user service to create a new user record in the database, associating them with the inviting admin's team.",
			"cellName": "Server Handles User Registration - controllers.js:L7",
			"cellId": "5c7eaa02-adbe-4c0f-b8bd-764757a7de9d",
