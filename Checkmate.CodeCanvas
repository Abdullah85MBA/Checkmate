		"97930f15-45cf-47f5-9277-b1cdbf0ade44": {
			"path": "97930f15-45cf-47f5-9277-b1cdbf0ade44",
			"cellName": "Backend: Service Layer Logic - monitorService.js:L46-56",
			"cellId": "97930f15-45cf-47f5-9277-b1cdbf0ade44",
